#!/usr/bin/env bash
set -euxo pipefail

# If you prefer to re-exec whole script as root, you could use:
# if [ "$EUID" -ne 0 ]; then exec sudo "$0" "$@"; fi
# But per your request we will prefix critical commands with sudo (Option 2).

# Set hostname (requires root)
sudo hostnamectl set-hostname ${hostname}

# --------------------------
# Networking requirements (kubeadm prerequisites)
# --------------------------
# Write modules file (use sudo tee for protected redirection)
cat <<'EOF' | sudo tee /etc/modules-load.d/k8s.conf >/dev/null
overlay
br_netfilter
EOF

# Load kernel modules (needs root)
sudo modprobe overlay || true
sudo modprobe br_netfilter || true

# Write sysctl config (use sudo tee)
cat <<'EOF' | sudo tee /etc/sysctl.d/k8s.conf >/dev/null
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
net.ipv4.ip_forward = 1
EOF

# Apply sysctl settings (needs root)
sudo sysctl --system

# -----------------------------------------------------------------------------
# Install prerequisites for apt repos & general tooling
# -----------------------------------------------------------------------------
sudo apt-get update
sudo apt-get install -y --no-install-recommends ca-certificates curl gnupg lsb-release apt-transport-https

# Ensure keyrings dir exists and is readable by apt
sudo install -d -m0755 /etc/apt/keyrings

# -----------------------------------------------------------------------------
# Install containerd
# -----------------------------------------------------------------------------
# Add Docker GPG key (dearmored) and repo, then install containerd.io
# Note: we write the keyring using gpg run as root and ensure permissions
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg
sudo chmod a+r /etc/apt/keyrings/docker.gpg

# Add docker apt repo (use the distro codename or UBUNTU_CODENAME)
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo \"${UBUNTU_CODENAME:-$VERSION_CODENAME}\") stable" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null

# Update and install only containerd (recommended for kubeadm)
sudo apt-get update
sudo apt-get install -y --no-install-recommends containerd.io

# -----------------------------------------------------------------------------
# Configure containerd to use the systemd cgroup driver
# -----------------------------------------------------------------------------
sudo mkdir -p /etc/containerd
# Generate default config and write it with sudo tee
sudo containerd config default | sudo tee /etc/containerd/config.toml >/dev/null

# Enable systemd cgroup. Use sudo sed to edit the protected file.
# This sed is a simple approach — verify for your containerd version if necessary.
sudo sed -i 's/SystemdCgroup = false/SystemdCgroup = true/' /etc/containerd/config.toml

# Reload systemd and enable containerd
sudo systemctl daemon-reload
sudo systemctl enable --now containerd

# -----------------------------------------------------------------------------
# Disable swap (kubeadm requirement)
# -----------------------------------------------------------------------------
sudo swapoff -a
# Comment out any swap lines in /etc/fstab to persist the change
sudo sed -i.bak '/\sswap\s/ s/^/#/' /etc/fstab

# -----------------------------------------------------------------------------
# Installing kubeadm, kubelet, kubectl (Kubernetes v1.33)
# -----------------------------------------------------------------------------
# Add Kubernetes apt key (dearmored) to keyrings and repo file
curl -fsSL https://pkgs.k8s.io/core:/stable:/v1.33/deb/Release.key | sudo gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg
sudo chmod a+r /etc/apt/keyrings/kubernetes-apt-keyring.gpg

echo "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.33/deb/ /" \
  | sudo tee /etc/apt/sources.list.d/kubernetes.list >/dev/null

sudo apt-get update
sudo apt-get install -y --no-install-recommends kubelet kubeadm kubectl

# Prevent automatic upgrades of core kube packages
sudo apt-mark hold kubelet kubeadm kubectl

# Ensure kubelet is enabled and running
sudo systemctl enable --now kubelet

# -----------------------------------------------------------------------------
# kubeadm workflow (master/worker conditional)
# -----------------------------------------------------------------------------
%{ if node == "master" ~}
# Master: initialise cluster (must run as root)
sudo kubeadm init \
  --token "${token}" \
  --token-ttl 15m \
  --apiserver-advertise-address "${master_private_ip}" \
  --upload-certs \
  %{~ if cidr != null ~}
  --pod-network-cidr "${cidr}" \
  %{~ endif ~}
  --node-name "${hostname}"

# (optional) prepare kubeconfig for ubuntu user:
# sudo mkdir -p /home/ubuntu/.kube
# sudo cp /etc/kubernetes/admin.conf /home/ubuntu/.kube/config
# sudo chown -R ubuntu:ubuntu /home/ubuntu/.kube
%{~ endif ~}

%{~ if node == "worker" ~}
# Worker: join cluster (must run as root)
# Prefer using the --discovery-token-ca-cert-hash securely if you have it,
# rather than --discovery-token-unsafe-skip-ca-verification.
sudo kubeadm join "${master_private_ip}:6443" \
  --token "${token}" \
  --discovery-token-unsafe-skip-ca-verification \
  --node-name "${hostname}"
%{~ endif }

# Indicate completion (non-root file under /home/ubuntu is fine but we will create as ubuntu ownership)
sudo touch /home/ubuntu/done
sudo chown ubuntu:ubuntu /home/ubuntu/done || true

# End of user_data
